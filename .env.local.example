# AdMob 실 광고 ID — 릴리스 빌드용 (2026-08-28)
#
# 사용법: 이 파일을 `.env.local` 로 복사한 뒤 아래 값을 AdMob 콘솔에서 발급한 실 ID로 채운다.
#   cp .env.local.example .env.local
#
# `.env.local` 은 .gitignore 에 있어 public repo 에 올라가지 않는다.
# 이 .example 파일에는 실제 값이 아니라 형식만 담으므로 커밋해도 안전하다.
#
# ⚠️ 값을 채우면 다음 릴리스 빌드부터 실 광고가 나간다(USE_TEST_ADS 자동 false).
#    실 광고를 개발 중 클릭하면 무효 트래픽으로 계정이 정지되니, 실기기 검증은
#    이 값을 비운 상태(테스트 광고)에서 하고 마지막 릴리스 빌드 직전에만 채운다.

# 배너 광고 단위 ID (형식: ca-app-pub-<16자리>/<10자리>)
VITE_ADMOB_BANNER=

# 보상형 광고 단위 ID (뽑기·이어하기 공용)
VITE_ADMOB_REWARDED=

# AdMob 앱 ID (형식: ca-app-pub-<16자리>~<10자리>). AndroidManifest 주입용.
# gradle 의 manifestPlaceholders 가 android/local.properties 의 admobAppId 를 읽으므로,
# 이 값은 android/local.properties 에 admobAppId=... 로도 넣어야 한다(아래 안내 참고).
VITE_ADMOB_APP_ID=

# 테스트 모드 강제(선택). 비워두면 실 ID 주입 여부로 자동 결정.
#   true  = 실 ID가 있어도 테스트 광고 사용(RTL 실기기 검증용)
#   false = 실 광고 강제
# VITE_ADMOB_USE_TEST=

# ─────────────────────────────────────────────────────────────────────────────
# 앱인토스(토스 미니앱) 광고그룹 ID — 릴리스 빌드용 (2026-09-09)
#
# 앱인토스 콘솔 → 인앱광고 → 광고그룹에서 발급한 ID를 넣는다.
# AdMob(Android)과 완전히 별개다 — 토스 빌드에만 쓰인다.
#
# ⚠️ 둘 다 반드시 채워야 한다. 하나라도 비면 토스 빌드가 그 자리에서 실패한다
#    ("하나 빠뜨리고 출시" 방지). 검증 로직: vite.config.ts 의 assertTossAdGroupIds
#
# ⚠️ 테스트 광고그룹 ID(ait-ad-test-*)를 넣으면 빌드가 거부된다. 출시 번들에
#    테스트 ID가 들어가면 심사에서 반려되기 때문이다(2026-09-09 실제 반려 사유).
#    테스트 광고로 실기기 검증을 하려면 이 값을 테스트 ID로 바꾼 뒤 `vite dev`
#    로 확인한다 — dev 서버는 검증을 통과시킨다.
#
# ⚠️ 광고그룹 생성 후 구글 반영에 최대 2시간 걸린다. 그 전에는 실 ID를 넣어도
#    광고가 안 뜬다.
# ⚠️ 실 광고를 개발 중 클릭하면 무효 트래픽으로 계정이 정지된다.
#    실기기 검증은 테스트 ID를 넣은 상태에서 하고, 실 ID로는 "노출되는지"만 확인한다.

# 배너 광고그룹 ID (뽑기 화면 하단)
VITE_TOSS_AD_BANNER=

# 보상형 광고그룹 ID (스테이지 실패 시 이어하기)
VITE_TOSS_AD_REWARDED_CONTINUE=
